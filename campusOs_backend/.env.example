# ===== CampusOS backend environment =====
# Copy to .env and fill in real values. NEVER commit the real .env file.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ===== Runtime =====
# Use NODE_ENV=production on Render/Vercel-backed production deployments.
NODE_ENV=development
PORT=5050

# ===== Database =====
# >>> PASTE YOUR MONGODB ATLAS CONNECTION STRING HERE <<<
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusos_dev?retryWrites=true&w=majority
# Local alternative: mongodb://127.0.0.1:27017/campusos_dev
MONGO_URI=

# ===== Client origins (comma-separated, no trailing slash) =====
# The frontend dev origin plus any production frontend domain.
# In production this is the exact Vercel origin, e.g.
#   CLIENT_URL=https://campusos.vercel.app
CLIENT_URL=http://localhost:5173

# ===== Authentication secrets =====
# All three must be DIFFERENT random values of 32+ bytes.
JWT_SECRET=
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Signs the stateless CSRF double-submit token.
CSRF_SECRET=

# ===== Cookie behaviour =====
# Set true only when the app is served over HTTPS (always true in production).
# Development runs on http://localhost, where Secure cookies are rejected by browsers.
COOKIE_SECURE=false

# ===== Integrations (optional in development; required in production) =====
# Production refuses to start without Cloudinary because certificate and
# document storage must not fall back to a local container disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay keys, from https://dashboard.razorpay.com/app/keys
# Test keys begin `rzp_test_`; live keys begin `rzp_live_`.
# Leave all three empty in development and the MOCK gateway is used instead.
# Production requires all three and refuses to start without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard > Webhooks > the endpoint ending
#   https://<your-api-host>/api/v1/payments/webhook/razorpay
# Shown once, on creation. Required to verify any incoming webhook; without it
# every delivery is rejected with 400.
#
# Leave this empty while the project has no public URL — there is nowhere for
# Razorpay to deliver to. Payments still settle, via the verification endpoint:
#
#     POST /api/v1/finance/payments/:id/verify
#
# The browser supplies a payment id; the server asks Razorpay whether the money
# really arrived and settles only if Razorpay says so. Same trust anchor as the
# webhook (the key secret), opposite direction. Accounts staff can also sweep
# every payment left behind by a closed browser:
#
#     POST /api/v1/finance/payments/verify-pending
RAZORPAY_WEBHOOK_SECRET=

# ===== Email =====
# Production refuses to start without SMTP_HOST: there is no readable local
# mailbox in a container, so verification and password-reset links would be lost.
# In development, leave SMTP_HOST empty and messages are appended to
# `dev-mailbox.jsonl` in the backend directory instead.
#
#     tail -f dev-mailbox.jsonl
#
# Set SMTP_HOST and the messages go to that server instead. `nodemailer` is a
# declared dependency and is installed with the backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CampusOS <no-reply@campusos.local>"

# Where the links in those emails point. Only the origin matters — the path is
# appended. Used for verification and reset links, so a wrong value sends people
# somewhere useless. In production this is the public Vercel URL.
WEB_URL=http://localhost:5173

# ===== First SUPER_ADMIN (used only by `npm run create-admin`) =====
# Remove ADMIN_PASSWORD from the host environment after the first account exists.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@campusos.local
ADMIN_PASSWORD=ChangeMe_Immediately_123!

# ===== Logging =====
# true = human-readable coloured logs; false = structured JSON.
LOG_PRETTY=true
# info in production; debug in development; silent in tests.
LOG_LEVEL=debug