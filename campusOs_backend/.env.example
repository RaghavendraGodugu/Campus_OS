# ===== CampusOS backend environment =====
# Copy to .env and fill in real values. NEVER commit the real .env file.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ===== Runtime =====
NODE_ENV=development
PORT=5000

# ===== Database =====
# >>> PASTE YOUR MONGODB ATLAS CONNECTION STRING HERE <<<
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusos_dev?retryWrites=true&w=majority
# Local alternative: mongodb://127.0.0.1:27017/campusos_dev
MONGO_URI=

# ===== Client origins (comma-separated, no trailing slash) =====
# The frontend dev origin plus any production frontend domain.
CLIENT_URL=http://localhost:5173

# ===== Authentication secrets =====
# All three must be DIFFERENT random values of 32+ bytes.
JWT_SECRET=
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Signs the stateless CSRF double-submit token.
CSRF_SECRET=

# ===== Cookie behaviour =====
# Set true only when the app is served over HTTPS (always true in production).
# Development runs on http://localhost, where Secure cookies are rejected by browsers.
COOKIE_SECURE=false

# ===== Integrations (optional in development; required in production) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay TEST keys, from https://dashboard.razorpay.com/app/keys
# while "Test Mode" is toggled on. They begin `rzp_test_`.
# Leave all three empty and the MOCK gateway is used instead, which is
# refused outright in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard > Webhooks > the endpoint ending /payments/webhook/razorpay.
# Shown once, on creation. Required to verify any incoming webhook; without it
# every delivery is rejected with 400.
#
# Leave this empty while the project has no public URL — there is nowhere for
# Razorpay to deliver to. Payments still settle, via the verification endpoint:
#
#     POST /api/v1/finance/payments/:id/verify
#
# The browser supplies a payment id; the server asks Razorpay whether the money
# really arrived and settles only if Razorpay says so. Same trust anchor as the
# webhook (the key secret), opposite direction. Accounts staff can also sweep
# every payment left behind by a closed browser:
#
#     POST /api/v1/finance/payments/verify-pending
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CampusOS <no-reply@campusos.local>"

# ===== First SUPER_ADMIN (used only by `npm run create-admin`) =====
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@campusos.local
ADMIN_PASSWORD=ChangeMe_Immediately_123!

# ===== Logging =====
# true = human-readable coloured logs; false = structured JSON.
LOG_PRETTY=true