# ===== CampusOS frontend environment =====
# Copy to .env and fill in. NEVER commit the real .env file.
#
# SECURITY: every variable prefixed with VITE_ is inlined into the browser
# bundle at build time and is therefore PUBLIC. Never put a database
# credential, JWT secret, Cloudinary secret, Razorpay secret or SMTP password
# in this file. Only values safe for any visitor to read belong here.

# Base URL of the CampusOS REST API, INCLUDING the version segment.
#
# The dev server proxies /api to the backend, so this stays same-origin and the
# session cookies keep their strict SameSite defaults. The /v1 is part of the
# base, not something the client adds: omitting it produces a 404 on every single
# request, and the app is blank with no useful error.
#
# In production, point it at wherever the API is served:
#   VITE_API_URL=https://api.example.edu/api/v1
VITE_API_URL=/api/v1

# Razorpay publishable key only. The key secret and webhook secret are
# server-side and must never appear here.
VITE_RAZORPAY_KEY_ID=

# Set true to show the "DEMO DATA" banner when running against seeded data.
VITE_SHOW_DEMO_BANNER=true