# ===== CampusOS frontend environment =====
# Copy to .env and fill in. NEVER commit the real .env file.
#
# SECURITY: every variable prefixed with VITE_ is inlined into the browser
# bundle at build time and is therefore PUBLIC. Never put a database
# credential, JWT secret, Cloudinary secret, Razorpay secret or SMTP password
# in this file. Only values safe for any visitor to read belong here.

# Base URL of the CampusOS REST API, INCLUDING the version segment.
#
# The dev server proxies /api to the backend, so this stays same-origin.
# Vercel does not run the backend, so the production value must be the absolute
# Render URL. The /v1 is part of the base, not something the client adds:
# omitting it produces a 404 on every request, and the app is blank with no
# useful error.
#
# Development:  VITE_API_URL=/api/v1
# Production:   VITE_API_URL=https://campusos-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Razorpay publishable key only. The key secret and webhook secret are
# server-side and must never appear here.
VITE_RAZORPAY_KEY_ID=

# Set true only when running against seeded demo data. The production Vercel
# project must set this to false.
VITE_SHOW_DEMO_BANNER=false